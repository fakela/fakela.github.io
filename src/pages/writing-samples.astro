---
import BaseLayout from '../layouts/BaseLayout.astro'
import { WritingSamples } from '../components/WritingSamples'
---

<BaseLayout title="Writing Samples">
  <div class="content-wrapper">
    <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem;">Writing Samples</h1>
    <p style="color: var(--text-muted); margin-bottom: 2rem; line-height: 1.7;">
      A selection of documentation and technical writing across API references, SDK docs, how-to guides, knowledge base articles, and blog posts. Filter by type to find what you're looking for.
    </p>
    <WritingSamples client:load />
  </div>
</BaseLayout>
