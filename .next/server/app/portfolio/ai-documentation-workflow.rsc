"--shiki-dark":"#85E89D"},"children":"        uses"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"readmeio/rdme@v8"}]]}],"\n",["$","span",null,{"children":[["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#85E89D"},"children":"        with"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":":"}]]}],"\n",["$","span",null,{"children":[["$","span",null,{"style":{"--shiki-light":"#22863A","--shiki-dark":"#85E89D"},"children":"          rdme"}],["$","span",null,{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"},"children":": "}],["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"openapi openapi/spec.json"}]]}],"\n",["$","span",null,{"children":["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"            --key=$\\{\\{ secrets.README_API_KEY \\}\\}"}]}],"\n",["$","span",null,{"children":["$","span",null,{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"},"children":"            --id=$\\{\\{ secrets.API_DEFINITION_ID \\}\\}"}]}]]}]]}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"When the engineering team updated the OpenAPI spec, the API reference on ReadMe updated automatically. No manual intervention. No drift."}],["$","h2",null,{"id":"what-ai-changed","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["What AI Changed",["$","$L1b",null,{"id":"what-ai-changed"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":["The clearest measure: pull requests went from first draft to review-ready an average of ",["$","strong",null,{"children":"three days faster"}]," after these workflows were in place."]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"But the less quantifiable change mattered more. Working with AI allowed me to operate across a wider surface area than a single writer realistically could:"}],["$","ul",null,{"className":"x:[:is(ol,ul)_&]:my-[.75em] x:not-first:mt-[1.25em] x:list-disc x:ms-[1.5em]","children":["\n",["$","li",null,{"className":"x:my-[.5em]","children":"Deeper research into the codebase before writing"}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":"More consistent audits across 75+ pages"}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":"Faster turnaround on new features shipping"}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":"Infrastructure that kept the docs accurate without manual checking"}],"\n"]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"And all without sacrificing accuracy or quality. The AI handled the repetitive scaffolding and consistency checks. I handled the judgment calls: what to document, how to structure it, what the merchant actually needed to understand, and when to push back on product decisions that would confuse users."}],["$","h2",null,{"id":"what-ai-didnt-change","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["What AI Didn’t Change",["$","$L1b",null,{"id":"what-ai-didnt-change"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"AI was useless for anything that required judgment about what to document. It couldn’t tell me which features merchants would struggle with. It couldn’t sit in product roadmap meetings and advocate for documentation being part of the release process. It couldn’t present documentation strategies to leadership or embed docs into the development cycle through Jira."}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"AI also couldn’t replace the conversations. A significant part of my job was talking to engineers about how a feature actually worked, talking to product about what was coming next, and talking to support about what merchants were asking. Those conversations informed everything I wrote. AI just made the writing part faster."}],["$","h2",null,{"id":"what-id-tell-someone-starting-out","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["What I’d Tell Someone Starting Out",["$","$L1b",null,{"id":"what-id-tell-someone-starting-out"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"If you’re a technical writer considering AI integration:"}],["$","ul",null,{"className":"x:[:is(ol,ul)_&]:my-[.75em] x:not-first:mt-[1.25em] x:list-disc x:ms-[1.5em]","children":["\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Start with the repeated tasks."}]," The first thing to automate isn’t writing. It’s the research, auditing, and scaffolding you do over and over."]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Create context files."}]," Style guides, project conventions, terminology lists. Give the AI a foundation before asking it to produce anything."]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Connect it to the source of truth."}]," MCP servers, direct repo access, whatever works. AI that can read your actual docs is orders of magnitude more useful than AI you’re copying and pasting to."]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Build the CI/CD pipeline."}]," AI catches some errors. Automated checks catch the rest. Together they catch almost everything."]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Own the output."}]," AI is a tool. The decisions, the architecture, the quality bar, those are yours."]}],"\n"]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":["$","$Lf",null,{"href":"/writing-samples","prefetch":"$undefined","className":"x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font]","children":"View writing samples from this project →"}]}]]}]}]]}]]}]}]
