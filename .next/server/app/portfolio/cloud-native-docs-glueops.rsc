2:["$","div",null,{"className":"x:mx-auto x:flex x:max-w-(--nextra-content-width)","children":["$","$L18",null,{"value":[{"value":"The Problem","id":"the-problem","depth":2},{"value":"Centralising into a Unified Docusaurus Site","id":"centralising-into-a-unified-docusaurus-site","depth":2},{"value":"Covering the Full Deployment Surface","id":"covering-the-full-deployment-surface","depth":2},{"value":"The Outcome","id":"the-outcome","depth":2}],"children":[["$","$L19",null,{}],["$","$L1a",null,{"metadata":{"title":"Cloud-Native Docs for GlueOps","filePath":"content/portfolio/cloud-native-docs-glueops.mdx","timestamp":1775577541000},"bottomContent":"$undefined","sourceCode":"$undefined","children":[["$","div",null,{"id":"nextra-skip-nav"}],["$","main",null,{"data-pagefind-body":true,"children":["$","div",null,{"className":"portfolio-post","children":[["$","h1",null,{"id":"$undefined","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-bold x:mt-2 x:text-4xl","children":["Cloud-Native Docs for GlueOps","$undefined"]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"GlueOps had scattered documentation across multiple GitHub repos with no central reference. Developers and users had to know which repo to look in, and even then the documentation within each repo was inconsistent in format and depth."}],["$","h2",null,{"id":"the-problem","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["The Problem",["$","$L1b",null,{"id":"the-problem"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"The information existed, but it was unfindable. Deployment processes for Docker Hub, GCP, GitHub, AWS, Azure, Terraform, and Quay each lived in different repositories. There was no consistent format, no central navigation, and no way for a new user to understand the full picture."}],["$","h2",null,{"id":"centralising-into-a-unified-docusaurus-site","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["Centralising into a Unified Docusaurus Site",["$","$L1b",null,{"id":"centralising-into-a-unified-docusaurus-site"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"I built a unified Docusaurus site that brought together deployment documentation across all seven platforms. Each platform had its own deployment process and configuration requirements, and the documentation needed to be clear enough that someone could follow it without prior context on GlueOps’ infrastructure."}],["$","h2",null,{"id":"covering-the-full-deployment-surface","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["Covering the Full Deployment Surface",["$","$L1b",null,{"id":"covering-the-full-deployment-surface"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"The documentation covered:"}],["$","ul",null,{"className":"x:[:is(ol,ul)_&]:my-[.75em] x:not-first:mt-[1.25em] x:list-disc x:ms-[1.5em]","children":["\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"AWS account setup"}]," and service quota configuration"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"GCP project setup"}]," and permissions"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"GitHub App and OAuth configuration"}]," for the platform integration"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Docker Hub"}]," deployment workflows"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Terraform"}]," infrastructure definitions"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"Environment secrets"}]," management"]}],"\n",["$","li",null,{"className":"x:my-[.5em]","children":[["$","strong",null,{"children":"First app deployment"}]," guides"]}],"\n"]}],["$","h2",null,{"id":"the-outcome","className":"x:tracking-tight x:text-slate-900 x:dark:text-slate-100 x:font-semibold x:target:animate-[fade-in_1.5s] x:mt-10 x:border-b x:pb-1 x:text-3xl nextra-border","children":["The Outcome",["$","$L1b",null,{"id":"the-outcome"}]]}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":"It was a short engagement, but the impact was straightforward: before, the information existed but was unfindable. After, it was organised, searchable, and maintained in one place. New team members and users could find what they needed without asking."}],["$","p",null,{"className":"x:not-first:mt-[1.25em] x:leading-7","children":["$","$Lf",null,{"href":"/writing-samples","prefetch":"$undefined","className":"x:focus-visible:nextra-focus x:text-primary-600 x:underline x:hover:no-underline x:decoration-from-font x:[text-underline-position:from-font]","children":"View writing samples from this project →"}]}]]}]}]]}]]}]}]
